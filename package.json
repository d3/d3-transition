{
  "name": "d3-transition",
  "version": "3.0.1",
  "description": "Animated transitions for D3 selections.",
  "homepage": "https://d3js.org/d3-transition/",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3/d3-transition.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "dom",
    "transition",
    "animation"
  ],
  "license": "ISC",
  "author": {
    "name": "Mike Bostock",
    "url": "https://bost.ocks.org/mike"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "module": "dist/d3-transition.mjs",
  "main": "dist/d3-transition.mjs",
  "jsdelivr": "dist/d3-transition.min.js",
  "unpkg": "dist/d3-transition.min.js",
  "exports": {
    "umd": "./dist/d3-transition.min.js",
    "default": "./dist/d3-transition.mjs"
  },
  "sideEffects": true,
  "dependencies": {
    "d3-color": "1 - 3",
    "d3-dispatch": "1 - 3",
    "d3-ease": "1 - 3",
    "d3-interpolate": "1 - 3",
    "d3-timer": "1 - 3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "d3-selection": "^3.0.0",
    "eslint": "^7.32.0",
    "jsdom": "^21.1.2",
    "mocha": "^10.8.2",
    "rollup": "^4.67.4"
  },
  "scripts": {
    "test": "mocha 'test/**/*-test.js' && eslint src test",
    "prepublishOnly": "rm -rf dist && rollup -c"
  },
  "engines": {
    "node": ">=12"
  },
  "peerDependencies": {
    "d3-selection": "2 - 3"
  }
}
